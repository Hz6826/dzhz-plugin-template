{
  "manifestVersion": 1,
  "id": "top.dzhz.plugin.template",
  "name": "插件模板",
  "summary": "一个把宿主支持的所有界面组件都摆一遍的模板插件，照着改就是你的插件",
  "version": "1.0.1",
  "versionCode": 13,
  "minAppVersionCode": 101,
  "author": {
    "name": "你的名字",
    "url": "https://github.com/your-name"
  },
  "projectUrl": "",
  "type": "dex",
  "apiVersion": 2,
  "dex": {
    "apk": "plugin.apk",
    "entryClass": "top.dzhz.plugin.template.TemplatePlugin",
    "pages": [
      {
        "id": "text",
        "title": "文字与样式",
        "group": "基础",
        "home": true
      },
      {
        "id": "input",
        "title": "输入与操作",
        "group": "基础"
      },
      {
        "id": "display",
        "title": "数据展示",
        "group": "进阶",
        "home": true
      },
      {
        "id": "layout",
        "title": "布局容器",
        "group": "进阶"
      },
      {
        "id": "backend",
        "title": "后端能力",
        "group": "进阶"
      },
      {
        "id": "about",
        "title": "关于"
      }
    ],
    "tools": [
      {
        "name": "echo",
        "definition": {
          "type": "function",
          "function": {
            "name": "echo",
            "description": "把你给的内容原样返回，用来确认小岱能调到这个插件。",
            "parameters": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "description": "任意文本"
                }
              },
              "required": [
                "text"
              ]
            }
          }
        }
      }
    ]
  }
}
